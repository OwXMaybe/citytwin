# Copy to .env.local (git-ignored) and restart `npm run dev` and/or the backend (both read this file).
# Free key: https://explore.openaq.org/register — enables OpenAQ ground stations for every city.
OPENAQ_API_KEY=

# CityTwin AI (Phase 5, backend only — never sent to the browser). Without it the assistant stays rule-based.
# Key: https://console.anthropic.com
ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5-5
# AI_EFFORT=medium
